cex.lab = 1.5              # axis label size
)
X <- c(0, 0.3, 0.7, 1)
EY <- c(0, 2, 0.7, 1)
plot(
X, EY,
type = "l",                # line plot
lwd = 2,                   # line thickness
xlab = "Fraction of Neighboring Units Treated",
ylab = "E[Y | Frac units treated]",
cex.lab = 1.5              # axis label size
)
X <- c(0, 0.3, 0.7, 1)
EY <- c(0, 2, 0.7, 1)
# Base plot
plot(
X, EY,
type = "l",
lwd = 3,
xlab = "Fraction of Neighboring Units Treated",
ylab = "E[Y | Frac units]",
cex.lab = 1.5
)
# Fit linear regression
fit <- lm(EY ~ X)
slope <- coef(fit)[2]
# Add regression line
abline(fit, col = "red", lwd = 2, lty = 2)
# Add label with slope
text(
x = 0.5, y = max(EY) + 0.2,
labels = paste0("Best linear approx (slope = ", round(slope, 2), ")"),
col = "red", cex = 1.2
)
