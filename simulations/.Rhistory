X <- c(0, 0.3, 0.7, 1)
EY <- c(0, 2, 0.7, 1)
# Fit linear regression
fit <- lm(EY ~ X)
slope <- coef(fit)[2]
# Plot with expanded y limits
plot(
X, EY,
type = "l",
lwd = 3,
xlab = "Fraction of Neighboring Units Treated",
ylab = "E[Y | Frac units]",
cex.lab = 1.5,
